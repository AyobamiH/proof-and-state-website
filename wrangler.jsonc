{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "proof-and-state-website",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2026-08-30",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "no_bundle": true,
  "assets": {
    "binding": "ASSETS",
    "directory": ".output/public",
  },
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.mjs", "**/*.js"],
    },
  ],
  "routes": [
    { "pattern": "proofandstate.com", "custom_domain": true },
    { "pattern": "www.proofandstate.com", "custom_domain": true },
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
}
